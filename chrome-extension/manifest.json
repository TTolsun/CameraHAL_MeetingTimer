{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Time per Turn",
  "description": "Set a meeting end time. Give each speaker a turn, share any time left over, and save the last few minutes for decisions.",
  "version": "1.6.3",
  "icons": {
    "16": "icons/timer-16.png",
    "32": "icons/timer-32.png",
    "48": "icons/timer-48.png",
    "128": "icons/timer-128.png"
  },
  "action": {
    "default_title": "Open Time per Turn",
    "default_icon": {
      "16": "icons/timer-16.png",
      "32": "icons/timer-32.png"
    }
  },
  "background": { "service_worker": "launcher.js" }
}
