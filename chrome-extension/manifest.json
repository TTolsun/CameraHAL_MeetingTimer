{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Time per Turn",
  "description": "Split the remaining meeting time among speakers and keep each turn on track with a compact presenter bar.",
  "version": "1.6.0",
  "icons": {
    "16": "icons/timer-16.png",
    "32": "icons/timer-32.png",
    "48": "icons/timer-48.png",
    "128": "icons/timer-128.png"
  },
  "action": {
    "default_title": "Open Time per Turn",
    "default_icon": {
      "16": "icons/timer-16.png",
      "32": "icons/timer-32.png"
    }
  },
  "background": { "service_worker": "launcher.js" }
}
