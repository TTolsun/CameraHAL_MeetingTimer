{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "회의 타이머",
  "description": "발표 시간을 나누고, 도구 모음에서 회의 타이머와 발표 막대를 엽니다.",
  "version": "1.4.0",
  "icons": {
    "16": "icons/timer-16.png",
    "32": "icons/timer-32.png",
    "48": "icons/timer-48.png",
    "128": "icons/timer-128.png"
  },
  "action": {
    "default_title": "회의 타이머 열기",
    "default_icon": {
      "16": "icons/timer-16.png",
      "32": "icons/timer-32.png"
    }
  },
  "background": { "service_worker": "launcher.js" }
}
